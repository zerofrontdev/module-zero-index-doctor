{
    "name": "zerofront/module-zero-index-doctor",
    "description": "Zero for Magento Open Source: what slows Magento's indexers down or stops them, with the fix for each: database settings, stuck reindexes, cron, modes, reindex times (bin/magento zero:index:doctor, System > Tools > Index Doctor).",
    "type": "magento2-module",
    "version": "1.3.6",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "indexer",
        "reindex",
        "mariadb",
        "mysql",
        "performance"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-rule-configurable": "*",
        "magento/module-cron": "*",
        "magento/module-indexer": "*"
    },
    "replace": {
        "fixstacks/module-zero-index-doctor": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\IndexDoctor\\": ""
        }
    }
}
